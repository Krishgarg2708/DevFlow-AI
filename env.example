ENCRYPTION_KEY=

# AI Provider (anthropic | openai)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS_PER_REQUEST=4000

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
